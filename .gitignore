# -----------------------------------------------------------------------------
# Dependencies & Package Managers
# -----------------------------------------------------------------------------
node_modules/
.pnpm-store/
# pnpm 必須プロジェクトのため、誤操作による他ツールのロックファイル混入を防止
package-lock.json
yarn.lock
bun.lockb

# -----------------------------------------------------------------------------
# Production builds, packages & distribution archives (Large generated artifacts)
# -----------------------------------------------------------------------------
dist/
release/
build/
out/
*.crx
*.xpi
*.zip
*.tar.gz
*.tgz
*.7z
*.rar

# -----------------------------------------------------------------------------
# Extension runtime downloads & Media (Prevent accidental large file commits)
# -----------------------------------------------------------------------------
# 拡張機能のダウンロード機能で生成される保存先フォルダー
XMedia/
downloads/
download/
media/
# 動画・音声ファイル（誤ってプロジェクト内にダウンロードされた場合のセーフガード）
*.mp4
*.webm
*.mov
*.avi
*.mkv
*.mp3
*.wav
*.m4a
*.aac

# -----------------------------------------------------------------------------
# Extension secrets, signing keys & certificates (NEVER commit to public repositories)
# -----------------------------------------------------------------------------
*.pem
*.key
*.cert
*.crt
*.pfx
*.p12
*.pkcs12
*.der
*.pub
*.keystore
*.jks
id_rsa*
id_ed25519*
keys/
secrets/
secret/
credentials/
credentials.json
client_secret*.json

# -----------------------------------------------------------------------------
# Environment variables, local configs & auth tokens
# -----------------------------------------------------------------------------
.env
.env.*
!.env.example
*.local
.npmrc

# -----------------------------------------------------------------------------
# Databases & dumps
# -----------------------------------------------------------------------------
*.dump
*.sql
*.sqlite
*.sqlite3
*.db

# -----------------------------------------------------------------------------
# Logs & profiling
# -----------------------------------------------------------------------------
logs/
*.log
npm-debug.log*
yarn-debug.log*
yarn-error.log*
pnpm-debug.log*
*.cpuprofile
*.heapsnapshot

# -----------------------------------------------------------------------------
# Test coverage, test results & build caches
# -----------------------------------------------------------------------------
*.tsbuildinfo
.tsbuildinfo
coverage/
.nyc_output/
.vitest/
.vitest-cache/
.eslintcache
playwright-report/
test-results/

# -----------------------------------------------------------------------------
# OS metadata & temporary files
# -----------------------------------------------------------------------------
.DS_Store
.AppleDouble
.LSOverride
Thumbs.db
ehthumbs.db
[Dd]esktop.ini
$RECYCLE.BIN/
*.tmp
*~
*.bak
*.orig

# -----------------------------------------------------------------------------
# Editor / IDE configuration & AI assistant caches
# -----------------------------------------------------------------------------
.idea/
.vscode/*
!.vscode/extensions.json
!.vscode/settings.json
.vs/
*.suo
*.ntvs*
*.njsproj
*.sln
*.sw?
.cursor/
.windsurf/
.chat/
.copilot/
